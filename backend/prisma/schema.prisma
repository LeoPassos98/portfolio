generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMINISTRADOR
  FUNCIONARIO

  @@map("perfil")
}

enum StatusOrdemServico {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO

  @@map("status_ordem_servico")
}

enum Visibilidade {
  PRIVADA
  PUBLICA

  @@map("visibilidade")
}

model Cliente {
  id          String         @id @default(uuid()) @db.Uuid
  nome        String         @db.Text
  telefone    String         @db.Text
  documento   String?        @unique @db.Text
  email       String?        @db.Text
  cep         String         @db.Text
  logradouro  String         @db.Text
  numero      String         @db.Text
  complemento String?        @db.Text
  bairro      String         @db.Text
  cidade      String         @db.Text
  uf          String         @db.Text
  ativo       Boolean        @default(true)
  criadoEm    DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  ordens      OrdemServico[]

  @@map("cliente")
}

model Funcionario {
  id                        String                  @id @default(uuid()) @db.Uuid
  nome                      String                  @db.Text
  telefone                  String                  @db.Text
  email                     String                  @db.Text
  ativo                     Boolean                 @default(true)
  criadoEm                  DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  usuario                   Usuario?
  ordensComoResponsavel     OrdemServico[]          @relation("ResponsavelAtual")
  historicosComoResponsavel HistoricoOrdemServico[] @relation("ResponsavelNoSnapshot")

  @@map("funcionario")
}

model Usuario {
  id                  String                  @id @default(uuid()) @db.Uuid
  emailLogin          String                  @unique @map("email_login") @db.Text
  senhaHash           String                  @map("senha_hash") @db.Text
  perfil              Perfil
  ativo               Boolean                 @default(true)
  deveAlterarSenha    Boolean                 @default(true) @map("deve_alterar_senha")
  funcionarioId       String                  @unique @map("funcionario_id") @db.Uuid
  funcionario         Funcionario             @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  historicosAlterados HistoricoOrdemServico[] @relation("AlteradoPorUsuario")

  @@map("usuario")
}

model OrdemServico {
  id            String                  @id @default(uuid()) @db.Uuid
  numero        String                  @unique @db.Text
  descricao     String                  @db.Text
  valor         Decimal                 @db.Decimal(12, 2)
  observacoes   String?                 @db.Text
  status        StatusOrdemServico      @default(AGUARDANDO)
  visibilidade  Visibilidade            @default(PRIVADA)
  versao        Int                     @default(1)
  criadoEm      DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime                @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm   DateTime?               @map("concluido_em") @db.Timestamptz(6)
  canceladoEm   DateTime?               @map("cancelado_em") @db.Timestamptz(6)
  clienteId     String                  @map("cliente_id") @db.Uuid
  responsavelId String                  @map("responsavel_id") @db.Uuid
  cliente       Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  responsavel   Funcionario             @relation("ResponsavelAtual", fields: [responsavelId], references: [id], onDelete: Restrict)
  historicos    HistoricoOrdemServico[]

  @@index([clienteId])
  @@index([responsavelId])
  @@map("ordem_servico")
}

model HistoricoOrdemServico {
  id                   String             @id @default(uuid()) @db.Uuid
  versao               Int
  descricao            String             @db.Text
  valor                Decimal            @db.Decimal(12, 2)
  observacoes          String?            @db.Text
  status               StatusOrdemServico
  visibilidade         Visibilidade
  concluidoEm          DateTime?          @map("concluido_em") @db.Timestamptz(6)
  canceladoEm          DateTime?          @map("cancelado_em") @db.Timestamptz(6)
  snapshotEm           DateTime           @default(now()) @map("snapshot_em") @db.Timestamptz(6)
  ordemServicoId       String             @map("ordem_servico_id") @db.Uuid
  responsavelId        String             @map("responsavel_id") @db.Uuid
  alteradoPorUsuarioId String             @map("alterado_por_usuario_id") @db.Uuid
  ordemServico         OrdemServico       @relation(fields: [ordemServicoId], references: [id], onDelete: Restrict)
  responsavel          Funcionario        @relation("ResponsavelNoSnapshot", fields: [responsavelId], references: [id], onDelete: Restrict)
  alteradoPorUsuario   Usuario            @relation("AlteradoPorUsuario", fields: [alteradoPorUsuarioId], references: [id], onDelete: Restrict)

  @@unique([ordemServicoId, versao])
  @@map("historico_ordem_servico")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
