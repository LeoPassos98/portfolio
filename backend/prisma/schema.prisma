generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMINISTRADOR
  FUNCIONARIO

  @@map("perfil")
}

enum StatusOrdemServico {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO

  @@map("status_ordem_servico")
}

enum Visibilidade {
  PRIVADA
  PUBLICA

  @@map("visibilidade")
}

enum TipoEnvironment {
  PRINCIPAL
  DEMO

  @@map("tipo_environment")
}

model Environment {
  id                     String                  @id @default(uuid()) @db.Uuid
  tipo                   TipoEnvironment
  criadoEm               DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiresAt              DateTime?               @map("expires_at") @db.Timestamptz(6)
  clientes               Cliente[]
  funcionarios           Funcionario[]
  usuarios               Usuario[]
  ordensServico          OrdemServico[]
  historicosOrdemServico HistoricoOrdemServico[]
  contadorOrdemServico   ContadorOrdemServico?

  @@map("environment")
}

model Cliente {
  id            String         @id @default(uuid()) @db.Uuid
  environmentId String         @map("environment_id") @db.Uuid
  nome          String         @db.Text
  telefone      String         @db.Text
  documento     String?        @db.Text
  email         String?        @db.Text
  cep           String         @db.Text
  logradouro    String         @db.Text
  numero        String         @db.Text
  complemento   String?        @db.Text
  bairro        String         @db.Text
  cidade        String         @db.Text
  uf            String         @db.Text
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  environment   Environment    @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  ordens        OrdemServico[]

  @@unique([environmentId, id])
  @@unique([environmentId, documento])
  @@map("cliente")
}

model Funcionario {
  id                        String                  @id @default(uuid()) @db.Uuid
  environmentId             String                  @map("environment_id") @db.Uuid
  nome                      String                  @db.Text
  telefone                  String                  @db.Text
  email                     String                  @db.Text
  ativo                     Boolean                 @default(true)
  criadoEm                  DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  environment               Environment             @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  usuario                   Usuario?
  ordensComoResponsavel     OrdemServico[]          @relation("ResponsavelAtual")
  historicosComoResponsavel HistoricoOrdemServico[] @relation("ResponsavelNoSnapshot")

  @@unique([environmentId, id])
  @@map("funcionario")
}

model Usuario {
  id                  String                  @id @default(uuid()) @db.Uuid
  environmentId       String                  @map("environment_id") @db.Uuid
  emailLogin          String                  @unique @map("email_login") @db.Text
  senhaHash           String                  @map("senha_hash") @db.Text
  perfil              Perfil
  ativo               Boolean                 @default(true)
  deveAlterarSenha    Boolean                 @default(true) @map("deve_alterar_senha")
  funcionarioId       String                  @map("funcionario_id") @db.Uuid
  environment         Environment             @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  funcionario         Funcionario             @relation(fields: [environmentId, funcionarioId], references: [environmentId, id], onDelete: Restrict, map: "usuario_environment_funcionario_fkey")
  historicosAlterados HistoricoOrdemServico[] @relation("AlteradoPorUsuario")

  @@unique([environmentId, id])
  @@unique([environmentId, funcionarioId])
  @@map("usuario")
}

model OrdemServico {
  id            String                  @id @default(uuid()) @db.Uuid
  environmentId String                  @map("environment_id") @db.Uuid
  numero        String                  @db.Text
  descricao     String                  @db.Text
  valor         Decimal                 @db.Decimal(12, 2)
  observacoes   String?                 @db.Text
  status        StatusOrdemServico      @default(AGUARDANDO)
  visibilidade  Visibilidade            @default(PRIVADA)
  versao        Int                     @default(1)
  criadoEm      DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime                @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  concluidoEm   DateTime?               @map("concluido_em") @db.Timestamptz(6)
  canceladoEm   DateTime?               @map("cancelado_em") @db.Timestamptz(6)
  clienteId     String                  @map("cliente_id") @db.Uuid
  responsavelId String                  @map("responsavel_id") @db.Uuid
  environment   Environment             @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  cliente       Cliente                 @relation(fields: [environmentId, clienteId], references: [environmentId, id], onDelete: Restrict, map: "ordem_servico_environment_cliente_fkey")
  responsavel   Funcionario             @relation("ResponsavelAtual", fields: [environmentId, responsavelId], references: [environmentId, id], onDelete: Restrict, map: "ordem_servico_environment_responsavel_fkey")
  historicos    HistoricoOrdemServico[]

  @@unique([environmentId, id])
  @@unique([environmentId, numero])
  @@index([clienteId])
  @@index([responsavelId])
  @@map("ordem_servico")
}

model ContadorOrdemServico {
  environmentId String      @id @map("environment_id") @db.Uuid
  ultimoNumero  Int         @default(0) @map("ultimo_numero")
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@map("contador_ordem_servico")
}

model HistoricoOrdemServico {
  id                   String             @id @default(uuid()) @db.Uuid
  environmentId        String             @map("environment_id") @db.Uuid
  versao               Int
  descricao            String             @db.Text
  valor                Decimal            @db.Decimal(12, 2)
  observacoes          String?            @db.Text
  status               StatusOrdemServico
  visibilidade         Visibilidade
  concluidoEm          DateTime?          @map("concluido_em") @db.Timestamptz(6)
  canceladoEm          DateTime?          @map("cancelado_em") @db.Timestamptz(6)
  snapshotEm           DateTime           @default(now()) @map("snapshot_em") @db.Timestamptz(6)
  ordemServicoId       String             @map("ordem_servico_id") @db.Uuid
  responsavelId        String             @map("responsavel_id") @db.Uuid
  alteradoPorUsuarioId String             @map("alterado_por_usuario_id") @db.Uuid
  environment          Environment        @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  ordemServico         OrdemServico       @relation(fields: [environmentId, ordemServicoId], references: [environmentId, id], onDelete: Restrict, map: "historico_environment_ordem_fkey")
  responsavel          Funcionario        @relation("ResponsavelNoSnapshot", fields: [environmentId, responsavelId], references: [environmentId, id], onDelete: Restrict, map: "historico_environment_responsavel_fkey")
  alteradoPorUsuario   Usuario            @relation("AlteradoPorUsuario", fields: [environmentId, alteradoPorUsuarioId], references: [environmentId, id], onDelete: Restrict, map: "historico_environment_autor_fkey")

  @@unique([environmentId, ordemServicoId, versao], map: "historico_environment_ordem_versao_key")
  @@index([environmentId, responsavelId], map: "historico_environment_responsavel_idx")
  @@index([environmentId, alteradoPorUsuarioId], map: "historico_environment_autor_idx")
  @@map("historico_ordem_servico")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
